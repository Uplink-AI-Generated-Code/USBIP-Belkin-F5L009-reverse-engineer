# Raw vendor download: untrusted InstallShield installer + driver-CD zip.
# The firmware image extracted from it is checked in as
# proprietary-Belkin-Silex/SX-2000U2_v2.1.5.bin.
/proprietary-Belkin-Silex/SX-2000U2/

# Large, noisy, regenerable linear disassembly sweeps
proprietary-Belkin-Silex/analysis/*/disasm_full.asm
# Unpack outputs (regenerable via `fw_codec.py unpack`)
*.unpacked/

__pycache__

# Large raw captures: the big write traces are multi-hundred-MB / >1GB.
# Keep the small keyboard dumps (already tracked); ignore the bulky ones.
Packet_Dumps/*GB*.pcapng
Packet_Dumps/128MB*.pcapng
# Local test write artifact
128MB.file.h2w
